# syntax=docker/dockerfile:1
# Warm job — pre-populates env images + EFS git mirrors (ADR-0020 / 5b).
# Built NOW (5a-i DoD 10) so 5b has no bootstrap problem: it is itself a
# container on the privileged EC2 pool (docker needed to build images) and
# must exist in ECR before it can put anything else there. The script is a
# placeholder until 5b implements warm_image_cache.py.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/

WORKDIR /app
# K-2: do NOT put /app/.venv/bin on PATH. The framework's uv venv would shadow
# system python/pip for every child process — INCLUDING the agent's `bash` tool —
# so `python` resolves to the framework interpreter, `pip` to a pip that installs
# where that interpreter never looks, and 5b's install_repo_script (conda activate
# + pip install -e .) would build the right env and still hand the agent the wrong
# python. entrypoint.sh invokes the venv binaries by absolute path instead, and
# everything below the entrypoint sees a clean system PATH.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1
# Locked deps + project first (layer cache), then the entrypoint.
# PA-9 provenance: config_snapshot facts baked at build time (docker_build_push.sh
# passes the real repo HEAD SHA + config hash). Inside the deployed container
# there is no .git and no infra/docker/, so without these the snapshot's
# framework_sha / gateway_config_hash would be None — and DoD 6 requires them
# non-empty on a real run.
ARG FRAMEWORK_SHA=unknown
ARG GATEWAY_CONFIG_HASH=unknown
ENV FRAMEWORK_SHA=$FRAMEWORK_SHA \
    GATEWAY_CONFIG_HASH=$GATEWAY_CONFIG_HASH


# docker CLI (builds env + harness images against the host daemon socket) and
# git (5b: --mirrors refreshes the EFS mirrors).
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker-cli git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The repo tree for the warm job: the script itself (entrypoint route) plus
# everything `_harness_build_context()` assembles into the harness-image build
# context, and what the harness Dockerfile COPYs (pyproject/uv.lock/swebench_eval).
COPY pyproject.toml uv.lock ./
COPY swebench_eval ./swebench_eval
COPY scripts/warm_image_cache.py /app/warm_image_cache.py
# ADR-0043: the per-instance builder (official-image base, digest-pinned by the
# committed snapshot).  The 4.1.0-era build_phase0_instances.py is gone.
COPY scripts/build_phase0_instances_v2.py /app/scripts/build_phase0_instances_v2.py
COPY scripts/capture_build_reqs.py /app/scripts/capture_build_reqs.py
COPY scripts/verify_harness_isolation.py /app/scripts/verify_harness_isolation.py
# Compaction build (Stage 2.2): the refresh Dockerfile (the last -inst layer,
# built with context /app here) COPYs scripts/mini_pruning_agent.py — the warm
# image must carry it for the build context or the refresh layer fails.
COPY scripts/mini_pruning_agent.py /app/scripts/mini_pruning_agent.py
COPY infra/docker/Dockerfile.harness-worker-env /app/infra/docker/Dockerfile.harness-worker-env
COPY infra/docker/Dockerfile.instance-layer /app/infra/docker/Dockerfile.instance-layer
# PART2 §3.1: the build now refreshes the framework into a pushed -hw instead
# of rebuilding it locally — the warm image must carry the refresh Dockerfile.
COPY infra/docker/Dockerfile.harness-worker-refresh /app/infra/docker/Dockerfile.harness-worker-refresh
COPY infra/docker/entrypoint.sh /app/entrypoint.sh
COPY infra/docker/entrypoint.sh /app/infra/docker/entrypoint.sh
# Stage 3.1: the -hw Dockerfile COPYs this into every harness image to record
# the resolved CLI versions — the warm image must carry it for the build context.
COPY infra/docker/write_harness_versions.sh /app/infra/docker/write_harness_versions.sh
RUN uv sync --frozen --no-dev
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["warm-job"]