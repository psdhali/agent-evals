# syntax=docker/dockerfile:1
# Eval worker — polls eval-jobs, grades via SwebenchRunner (privileged DinD).
# Runs on the EC2 pool (Bottlerocket aws-ecs-2, X86_64) — the task is
# `privileged = true` and mounts the host docker socket, so the image needs
# the docker CLI to drive the host daemon. Build linux/amd64 (B-3/C-1).
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /uvx /bin/

WORKDIR /app
# K-2: do NOT put /app/.venv/bin on PATH. The framework's uv venv would shadow
# system python/pip for every child process — INCLUDING the agent's `bash` tool —
# so `python` resolves to the framework interpreter, `pip` to a pip that installs
# where that interpreter never looks, and 5b's install_repo_script (conda activate
# + pip install -e .) would build the right env and still hand the agent the wrong
# python. entrypoint.sh invokes the venv binaries by absolute path instead, and
# everything below the entrypoint sees a clean system PATH.
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1
# Locked deps + project first (layer cache), then the entrypoint.
# PA-9 provenance: config_snapshot facts baked at build time (docker_build_push.sh
# passes the real repo HEAD SHA + config hash). Inside the deployed container
# there is no .git and no infra/docker/, so without these the snapshot's
# framework_sha / gateway_config_hash would be None — and DoD 6 requires them
# non-empty on a real run.
ARG FRAMEWORK_SHA=unknown
ARG GATEWAY_CONFIG_HASH=unknown
ENV FRAMEWORK_SHA=$FRAMEWORK_SHA \
    GATEWAY_CONFIG_HASH=$GATEWAY_CONFIG_HASH


# Docker CLI: the eval worker grades by launching containers on the HOST
# daemon (DinD via the mounted /var/run/docker.sock), not inside this image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker-cli \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./
COPY swebench_eval ./swebench_eval
COPY scripts/ ./scripts/
# 5a-ii: eval worker may write results; bake the SQL the app resolves by path.
COPY infra/docker/init.sql /app/infra/docker/init.sql
RUN uv sync --frozen --no-dev
COPY infra/docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["eval-worker"]