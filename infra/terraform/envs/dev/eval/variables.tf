variable "harness_task_families" {
  type        = map(object({ image = string }))
  default     = {}
  description = <<EOT
    Per-env harness task-definition families (ADR-0030 H2), family -> -hw image.
    Generated by scripts/gen_harness_task_families.py from the warm-cache
    manifest into harness-task-families.auto.tfvars.json — do NOT hand-edit and
    do NOT commit it (adoption finding 10: it is per deployment; `make up`
    regenerates it before every eval apply). Empty default keeps plan/validate
    green before the warm job has written a manifest.
  EOT
}

variable "framework_sha" {
  type        = string
  default     = "latest"
  description = <<EOT
    The ECR image TAG the EC2-pool task-defs (warm-job, eval-worker) resolve to a
    digest at apply time. Default "latest" preserves the pre-2026-09-02 behavior
    (non-breaking: a plain apply keeps resolving :latest). Pass the per-commit tag
    produced by scripts/docker_build_push.sh (`-var framework_sha=<git-sha>`) for a
    DETERMINISTIC, immutable pin — the tag cannot move, so plan-time resolution
    cannot capture a stale digest, and a reused EC2 host is forced to pull the exact
    build. This is the durable deploy knob: set it to the commit you intend to run,
    re-apply, then roll. See the data.aws_ecr_image comment in main.tf.
  EOT
}
